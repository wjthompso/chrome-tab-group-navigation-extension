{
  "manifest_version": 3,
  "name": "Tab Group Navigation",
  "version": "0.1.0",
  "description": "Navigate between Chrome tab groups quickly from the toolbar.",
  "permissions": ["tabGroups", "tabs"],
  "action": {
    "default_title": "Tab Group Navigation",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
